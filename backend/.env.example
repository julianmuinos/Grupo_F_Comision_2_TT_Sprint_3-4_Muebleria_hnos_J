# Configuración del Servidor y Entorno - Mueblería Hermanos Jota
PORT=5000

# URL del Frontend (CORS) - Opcional: si se omite, permite todos los orígenes por defecto en desarrollo
CLIENT_URL=http://localhost:5173

# Conexión a MongoDB Atlas (Reemplazar <usuario>, <password> y <cluster> con tus credenciales)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/muebleria_hermanos_jota?retryWrites=true&w=majority
